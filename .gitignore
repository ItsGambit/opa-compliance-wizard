# Credentials -- never committed, see README "Security: encrypted credential storage"
.env
environments.json
environments.json.*
TestCreds.txt
ubuntuserver.txt

# Locally-preserved Secrets Access Dashboard System Log history (opt-in,
# see the "preserve logs locally" setting) -- audit metadata, not a
# credential, but still local-machine-only state that shouldn't be committed
secrets_log_cache.json

# This tool's own write-action audit trail (see engine.log_audit_event) --
# real operational data (who did what, when) specific to whichever
# deployment produced it, not something to ship in the repo
audit_log.jsonl

# Admin-configured announcement banner (see engine.get/set_banner_config) --
# deployment-specific content (an org's own maintenance/incident notice),
# not something to ship in the repo template
banner_config.json

# Admin-configured Okta group IDs for the login gate (see
# engine.get/set_access_control_config) -- deployment-specific Okta group
# IDs, not something to ship in the repo template
access_control.json

# Compliance reporting dashboard's Okta+OPA audit archive (see
# audit_store.py) -- real ingested tenant event history, plus SQLite's
# own WAL/journal sidecar files, all deployment-specific local instance
# data, same treatment as environments.json/secrets_log_cache.json
audit_store.db
audit_store.db-wal
audit_store.db-shm

# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# This tool's own output
folders_result_*.csv

# Frontend build/deps (frontend/.gitignore also covers these for that subtree;
# listed here too so a root-level `git status` never shows them as untracked)
frontend/node_modules/
frontend/dist/

# Internal design/planning docs -- stay local-only, never pushed to the
# public GitHub remote even though code/deploy docs in docs/ do get
# pushed. See CLAUDE memory "local-only design docs" for why: a candid
# writeup of this app's remaining architectural weak points shouldn't be
# visible to anyone before they're actually fixed.
docs/fast-follow-redesign.md

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
