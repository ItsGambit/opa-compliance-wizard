[Unit]
Description=OPA Compliance Wizard auth gate (Okta OIDC login, front of nginx auth_request)
After=network.target opa-compliance-wizard.service

[Service]
Type=simple
User=rparikh
WorkingDirectory=/home/rparikh/opa-secrets-folders
EnvironmentFile=/etc/opa-compliance-wizard.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/rparikh/opa-secrets-folders/.venv/bin/python server/auth_gate.py --port 8767
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
