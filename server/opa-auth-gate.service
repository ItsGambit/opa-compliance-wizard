[Unit]
Description=OPA Compliance Wizard auth gate (Okta OIDC login, front of nginx auth_request)
After=network.target opa-compliance-wizard.service

[Service]
Type=simple
User=rparikh
WorkingDirectory=/home/rparikh/opa-secrets-folders
EnvironmentFile=/etc/opa-compliance-wizard.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/home/rparikh/opa-secrets-folders/.venv/bin/python server/auth_gate.py --port 8767
Restart=on-failure
RestartSec=3

# Phase 8 of docs/fast-follow-redesign.md -- same hardening and the
# same three ReadWritePaths= as opa-compliance-wizard.service's own
# comment explains (including /run/user/1000, confirmed live 2026-10-02
# to also be covered by ProtectHome, not just /home itself). This unit
# needs all three too, not just the keyring one: it has no app data
# files of its own, but auth_gate.py's _load_keyring_secret still calls
# into the OS keyring directly (same as the wizard process), so it
# needs the identical ~/.local/share/keyrings/ + /run/user/1000
# carve-outs.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=/home/rparikh/opa-secrets-folders
ReadWritePaths=/home/rparikh/.local/share/keyrings
ReadWritePaths=/run/user/1000
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
