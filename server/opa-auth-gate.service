[Unit]
Description=OPA Compliance Wizard auth gate (Okta OIDC login, front of nginx auth_request)
After=network.target opa-compliance-wizard.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
Environment=OPA_DATA_DIR=__DATA_DIR__
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/opa-compliance-wizard.env
Environment=XDG_RUNTIME_DIR=/run/user/__APP_UID__
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/__APP_UID__/bus
ExecStart=__APP_DIR__/.venv/bin/python server/auth_gate.py --port 8767
Restart=on-failure
RestartSec=3

# 5.52.0: __APP_UID__ is the application account's numeric id (server/install.sh fills it from `id -u`; it used to be
# a hardcoded 1000 that hosting.md asked you to change by hand). The text below says 1000 where it tells the 2026-10-02
# incident, which happened on an account with that id.
#
# 5.47.0 layout (server/install.sh writes this unit): __APP_DIR__ is
# /opt/opa-compliance-wizard/current (a symlink to the active release; the
# application user cannot write it), __DATA_DIR__ is
# /var/lib/opa-compliance-wizard (the only place the application writes, via
# OPA_DATA_DIR). The keyring and /run/user carve-outs below are unchanged:
# see the ProtectHome incident described in this file's comments.
#
# Phase 8 of docs/fast-follow-redesign.md -- same hardening and the
# same three ReadWritePaths= as opa-compliance-wizard.service's own
# comment explains (including /run/user/1000, confirmed live 2026-10-02
# to also be covered by ProtectHome, not just /home itself). This unit
# needs all three too, not just the keyring one: it has no app data
# files of its own, but auth_gate.py's _load_keyring_secret still calls
# into the OS keyring directly (same as the wizard process), so it
# needs the identical ~/.local/share/keyrings/ + /run/user/1000
# carve-outs.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=__DATA_DIR__
ReadWritePaths=__APP_USER_HOME__/.local/share/keyrings
ReadWritePaths=/run/user/__APP_UID__
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
