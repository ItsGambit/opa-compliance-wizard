[Unit]
Description=OPA Compliance Wizard
After=network.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=/etc/opa-compliance-wizard.env
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=__APP_DIR__/server/start-headless.sh
Restart=on-failure
RestartSec=3

# Phase 8 of docs/fast-follow-redesign.md: defense-in-depth hardening,
# free given this already runs as an unprivileged user with no
# capability requirements. ProtectHome=read-only (not the blanket
# ProtectHome=false/true) PLUS three explicit ReadWritePaths= -- this
# app's own data files (audit_store.db etc.) live directly under
# WorkingDirectory, which is itself under $HOME; start-headless.sh's
# gnome-keyring-daemon --login needs read/write access to
# ~/.local/share/keyrings/ to persist the unlocked collection across
# restarts (see that script's own comment); and /run/user/1000 (this
# unit's own XDG_RUNTIME_DIR, where the keyring daemon's control socket
# actually lives) is ALSO implicitly covered by ProtectHome -- confirmed
# live, 2026-10-02: without this third path, gnome-keyring-daemon failed
# with "couldn't create socket directory: /run/user/1000/keyring:
# Read-only file system" and crash-looped the whole service. All three
# are real, confirmed conflicts, not theoretical.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ReadWritePaths=__APP_DIR__
ReadWritePaths=__APP_USER_HOME__/.local/share/keyrings
ReadWritePaths=/run/user/1000
ProtectKernelTunables=true
ProtectControlGroups=true
UMask=0077

[Install]
WantedBy=multi-user.target
